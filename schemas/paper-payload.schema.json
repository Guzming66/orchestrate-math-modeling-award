{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/orchestrate-math-modeling/paper-payload-v4.schema.json",
  "title": "Sanitized contest-paper scientific payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "questions"],
  "properties": {
    "schema_version": {"const": 4},
    "status": {"enum": ["draft", "ready"]},
    "notes": {"type": "string"},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id", "evidence_profile", "problem_summary", "assumptions", "core_model",
          "derivation_summary", "key_results", "validation_summary", "sensitivity_and_limits",
          "precision_policy", "complexity_value", "presentation_plan", "paper_section", "figures"
        ],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "evidence_profile": {
            "enum": ["analytical", "deterministic_numerical", "optimization", "statistical", "simulation", "machine_learning"]
          },
          "problem_summary": {"type": "string", "minLength": 1},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "core_model": {"type": "string", "minLength": 1},
          "derivation_summary": {"type": "string", "minLength": 1},
          "algorithm_summary": {"type": "string"},
          "key_results": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "comparison_summary": {"type": "string"},
          "validation_summary": {"type": "string"},
          "sensitivity_and_limits": {"type": "string"},
          "precision_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["display_rule", "justification", "dominant_uncertainty"],
            "properties": {
              "display_rule": {"type": "string"},
              "justification": {"type": "string"},
              "dominant_uncertainty": {"type": "string"}
            }
          },
          "complexity_value": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "added_complexity", "structural_need", "incremental_gain", "decision"],
            "properties": {
              "mode": {"enum": ["no_extra_complexity", "semantics_required", "incremental_change"]},
              "added_complexity": {"type": "string", "minLength": 1},
              "structural_need": {"type": "string", "minLength": 1},
              "incremental_gain": {"type": ["string", "null"]},
              "decision": {"type": "string", "minLength": 1}
            },
            "allOf": [
              {
                "if": {"properties": {"mode": {"const": "incremental_change"}}, "required": ["mode"]},
                "then": {"properties": {"incremental_gain": {"type": "string", "minLength": 1}}}
              }
            ]
          },
          "presentation_plan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "answer_form", "answer_anchor", "answer_takeaway",
              "validation_form", "validation_anchor", "validation_takeaway", "mechanism_visual",
              "mechanism_visual_reason", "mechanism_visual_must_show"
            ],
            "properties": {
              "answer_form": {"enum": ["pending", "prose", "equation", "table", "figure"]},
              "answer_anchor": {"type": "string"},
              "answer_takeaway": {"type": "string"},
              "validation_form": {"enum": ["pending", "prose", "equation", "table", "figure"]},
              "validation_anchor": {"type": "string"},
              "validation_takeaway": {"type": "string"},
              "mechanism_visual": {"enum": ["pending", "required", "not_applicable"]},
              "mechanism_visual_reason": {"type": "string", "minLength": 1},
              "mechanism_visual_must_show": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "geometry_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim_anchor", "objects", "relations", "formula_anchor", "figure_anchor",
                "not_needed_reason", "placement", "ten_second_takeaway", "final_size_reviewed"
              ],
              "properties": {
                "claim_anchor": {"type": "string", "minLength": 1},
                "objects": {
                  "type": "array", "minItems": 2, "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "relations": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "formula_anchor": {"type": "string", "minLength": 1},
                "figure_anchor": {"type": ["string", "null"]},
                "not_needed_reason": {"type": ["string", "null"]},
                "placement": {"type": "string", "minLength": 1},
                "ten_second_takeaway": {"type": "string", "minLength": 1},
                "final_size_reviewed": {"type": "boolean"}
              },
              "oneOf": [
                {
                  "properties": {
                    "figure_anchor": {"type": "string", "minLength": 1},
                    "not_needed_reason": {"type": "null"}
                  }
                },
                {
                  "properties": {
                    "figure_anchor": {"type": "null"},
                    "not_needed_reason": {"type": "string", "minLength": 1}
                  }
                }
              ]
            }
          },
          "paper_section": {"type": "string", "minLength": 1},
          "figures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path", "role", "supported_claim", "source_data", "generator", "paper_anchor",
                "final_width", "minimum_label_pt", "final_size_reviewed"
              ],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "role": {"enum": ["mechanism", "data", "diagnostic", "decision"]},
                "supported_claim": {"type": "string", "minLength": 1},
                "source_data": {"type": "string", "minLength": 1},
                "generator": {"type": "string", "minLength": 1},
                "paper_anchor": {"type": "string", "minLength": 1},
                "claim_anchor": {"type": "string", "minLength": 1},
                "final_width": {"type": "string", "minLength": 1},
                "minimum_label_pt": {"type": "number", "minimum": 6},
                "samples_per_pixel": {"type": ["number", "null"], "minimum": 0},
                "overplot_handling": {"type": "string", "minLength": 1},
                "final_size_reviewed": {"type": "boolean"}
              },
              "allOf": [
                {
                  "if": {
                    "properties": {"role": {"enum": ["data", "diagnostic", "decision"]}},
                    "required": ["role"]
                  },
                  "then": {
                    "required": [
                      "claim_anchor", "final_width", "minimum_label_pt", "samples_per_pixel",
                      "overplot_handling", "final_size_reviewed"
                    ]
                  }
                }
              ]
            }
          },
          "citations": {"type": "array", "items": {"type": "string"}}
        },
        "allOf": [
          {
            "if": {"properties": {"evidence_profile": {"not": {"const": "analytical"}}}},
            "then": {"required": ["algorithm_summary"], "properties": {"algorithm_summary": {"minLength": 1}}}
          }
        ]
      }
    }
  }
}
